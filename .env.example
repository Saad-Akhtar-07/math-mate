# Copy this file to .env in the project root. Never commit .env.
# In Supabase, open the project and choose Connect > Session pooler.
# Copy the host and user from there; the pooler host cannot be inferred from the region.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Browser origins allowed to call the backend directly (Vite also proxies /api locally).
MATH_MATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per API process. Keep workers x pool size within the Supabase connection budget.
MATH_MATE_DB_POOL_SIZE=5

# Private file uploads: server only. Obtain the URL and secret from Supabase API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY (leave empty when using a new secret).
SUPABASE_SERVICE_ROLE_KEY=
MATH_MATE_STORAGE_BUCKET=math-mate-solutions


SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
