# Copy this file to .env in the project root. Never commit .env.
# In Supabase, open the project and choose Connect > Session pooler.
# Copy the host and user from there; the pooler host cannot be inferred from the region.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Browser origins allowed to call the backend directly (Vite also proxies /api locally).
MATH_MATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
