# Copy this file to .env in the project root. Never commit .env.
# In Supabase, open the project and choose Connect > Session pooler.
# Copy the host and user from there; the pooler host cannot be inferred from the region.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Math Mate uses this one Supabase PostgreSQL database in development and production.
# Schema changes and questions are applied with:
#   python -m backend.scripts.migrate --apply
#   python -m backend.scripts.import_questions --apply

# Browser origins allowed to call the backend directly (Vite also proxies /api locally).
MATH_MATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per API process. Keep workers x pool size within the Supabase connection budget.
MATH_MATE_DB_POOL_SIZE=5

# Private file uploads: server only. Obtain the URL and secret from Supabase API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY (leave empty when using a new secret).
SUPABASE_SERVICE_ROLE_KEY=
MATH_MATE_STORAGE_BUCKET=math-mate-solutions
SUPABASE_PUBLISHABLE_KEY=
# Optional override; normally derived from SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# AI marking and tutoring: backend only. Never put the key in frontend variables.
# off | fake | deepseek. Default off: a configured key alone never enables paid calls.
# Use fake for free local development; deepseek only when paid calls are intended.
MATH_MATE_AI_PROVIDER=off
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Daily spend caps in USD (UTC day), enforced before each request at worst-case cost.
MATH_MATE_AI_DAILY_BUDGET_USD=0.50
MATH_MATE_AI_LEARNER_DAILY_BUDGET_USD=0.05
MATH_MATE_MARKER_REASONING_EFFORT=low
MATH_MATE_MARKER_MAX_TOKENS=4096
MATH_MATE_OBSERVER_MAX_TOKENS=200
MATH_MATE_TUTOR_MAX_TOKENS=400
MATH_MATE_AI_TIMEOUT_SECONDS=60
