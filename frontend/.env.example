# Leave blank for local development; Vite proxies /api to FastAPI on port 8000.
# Set the deployed backend origin for a separately hosted production frontend.
VITE_API_URL=

# Public browser credentials from Supabase Project Settings > API.
# Never put the secret/service-role key or database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
